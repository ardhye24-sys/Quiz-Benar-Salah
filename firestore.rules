rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{id} {
      // Siapa pun boleh memainkan game (baca soal)
      allow read: if true;
      // Hanya akun guru yang boleh tambah/ubah/hapus soal.
      // GANTI dengan email akun guru yang dibuat di Firebase Authentication > Users.
      allow write: if request.auth != null
                   && request.auth.token.email == "guru@email.com";
    }
  }
}
