rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{id} {
      // Siapa pun boleh memainkan game (baca soal)
      allow read: if true;
      // Hanya UID anonymous guru yang boleh tambah/ubah/hapus soal.
      // GANTI "UID_GURU" dengan UID yang tampil di Dashboard Guru setelah login pertama.
      allow write: if request.auth != null
                   && request.auth.uid == "UID_GURU";
    }
  }
}
