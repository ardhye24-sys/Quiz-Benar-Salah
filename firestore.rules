rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil pengguna / akun guru
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subkoleksi soal khusus untuk setiap akun guru
      match /questions/{id} {
        // Publik boleh membaca soal agar game kuis bisa dimainkan di kelas
        allow read: if true;
        // HANYA pemilik akun yang boleh membuat, mengubah, atau menghapus soal miliknya sendiri
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
