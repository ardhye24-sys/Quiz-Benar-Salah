rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Publik/siswa dapat membaca soal kuis agar game bisa dimainkan di kelas
    match /{document=**} {
      allow read: if true;
    }

    // 2. Akun guru yang login (terautentikasi) diizinkan menulis ke database
    match /{document=**} {
      allow write: if request.auth != null;
    }
  }
}
